#!/usr/bin/env bash
# cog-bump-release — bump version and set GITHUB_OUTPUT for the release workflow.
# Runs cog bump --auto, captures the result, and writes bumped/version to
# $GITHUB_OUTPUT. Exits 1 on unexpected errors so the workflow fails red.

set -o pipefail

if cog bump --auto 2>&1 | tee /tmp/cog-bump-output.txt; then
    echo "bumped=true" >> "$GITHUB_OUTPUT"
    echo "version=$(git describe --tags --abbrev=0)" >> "$GITHUB_OUTPUT"
else
    if grep -q "Nothing to bump" /tmp/cog-bump-output.txt; then
        echo "bumped=false" >> "$GITHUB_OUTPUT"
    else
        exit 1
    fi
fi
