#!/usr/bin/env bash
# cog-bump-release — bump version and set GITHUB_OUTPUT for the release workflow.
# Runs cog bump --auto, captures the result, and writes bumped/version to
# $GITHUB_OUTPUT. Exits 1 on unexpected errors so the workflow fails red.

die() {
    printf "\033[31merror: %s\033[0m\n" "$1" >&2
    exit 1
}

cog bump --auto --annotated 2>&1 | tee /tmp/cog-bump-output.txt

if [ "${PIPESTATUS[0]}" -eq 0 ]; then
    printf "bumped=true\n" >> "$GITHUB_OUTPUT"
    printf "version=%s\n" "$(git describe --tags --abbrev=0)" >> "$GITHUB_OUTPUT"
elif grep --quiet "Nothing to bump" /tmp/cog-bump-output.txt; then
    printf "bumped=false\n" >> "$GITHUB_OUTPUT"
else
    die "cog bump failed"
fi
